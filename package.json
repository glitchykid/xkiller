{
  "name": "xkiller",
  "version": "0.1.0",
  "private": true,
  "description": "ETH perpetual futures learning and simulation lab",
  "author": "glitchykid",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs --web",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "build:ui": "vite build && node scripts/build-electron.mjs",
    "build": "npm run check && npm run build:ui && dotnet build backend/Xkiller.Api -c Release",
    "test:client": "node --test tests/client.test.mjs",
    "test": "npm run test:client && dotnet run --project tests/Xkiller.Tests -c Release",
    "package": "npm run check && npm run build:ui && node scripts/package.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^24.0.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "^0.27.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "5.57.1",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "8.3.1"
  },
  "build": {
    "appId": "com.glitchykid.xkiller",
    "productName": "Xkiller",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "artifacts/backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "artifactName": "Xkiller-${version}-${arch}.${ext}"
  }
}
