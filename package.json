{
  "name": "xkiller",
  "version": "0.2.3",
  "private": true,
  "description": "ETH perpetual futures learning and simulation lab",
  "author": "glitchykid",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs --web",
    "check": "svelte-check --tsconfig ./tsconfig.json && node node_modules/typescript-native/bin/tsc -p tsconfig.electron.json --noEmit",
    "build:ui": "vite build && node scripts/build-electron.mjs",
    "build": "npm run check && npm run build:ui && dotnet build backend/Xkiller.Api -c Release",
    "test:client": "node --test tests/client.test.mjs",
    "test": "npm run test:client && dotnet run --project tests/Xkiller.Tests -c Release",
    "package": "npm run check && npm run build:ui && node scripts/package.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "typescript-native": "npm:typescript@7.0.2"
  },
  "build": {
    "appId": "com.glitchykid.xkiller",
    "productName": "Xkiller",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "artifacts/backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "artifactName": "Xkiller-${version}-${arch}.${ext}"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
